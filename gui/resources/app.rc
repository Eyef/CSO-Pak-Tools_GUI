// Windows resource script for cso-pak-gui.exe.
//
// Provides two things Explorer/Windows read directly from the .exe:
//  - the application icon (shown in Explorer, taskbar, Alt-Tab)
//  - the VERSIONINFO block (shown on the exe's Properties -> Details tab:
//    product name, version, company/author, description, etc.)
//
// cpb.ico must sit next to this file (gui/resources/cpb.ico). Resource ID 1
// is used for the icon deliberately: Windows picks the icon with the lowest
// resource ID as the one shown for the file itself in Explorer.

1 ICON "cpb.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Y-Dr. Now"
            VALUE "FileDescription", "CSO Pak Browser"
            VALUE "FileVersion", "1.0.1.0"
            VALUE "InternalName", "cso-pak-gui"
            VALUE "LegalCopyright", "Y-Dr. Now"
            VALUE "OriginalFilename", "cso-pak-gui.exe"
            VALUE "ProductName", "CSO Pak Browser 1.0.1"
            VALUE "ProductVersion", "1.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
