// Windows resource script for cso-pak-gui.exe.
//
// Provides two things Explorer/Windows read directly from the .exe:
//  - the application icon (shown in Explorer, taskbar, Alt-Tab)
//  - the VERSIONINFO block (shown on the exe's Properties -> Details tab:
//    product name, version, company/author, description, etc.)
//
// cpb.ico must sit next to this file (gui/resources/cpb.ico). Resource ID 1
// is used for the icon deliberately: Windows picks the icon with the lowest
// resource ID as the one shown for the file itself in Explorer.
//
// winres.h is required here: it's what defines VS_VERSION_INFO as the
// numeric resource ID 1. Without it, the identifier doesn't resolve, and
// while rc.exe still links the icon fine, GetFileVersionInfo (which is what
// Explorer's Properties -> Details tab and every other Windows API that
// reads version info uses) can't find the VERSIONINFO block at all -- the
// exe ends up with no version info even though the .rc "looks" complete.
#include <winres.h>

1 ICON "cpb.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Y-Dr. Now"
            VALUE "FileDescription", "CSO Pak Browser"
            VALUE "FileVersion", "1.3.0.0"
            VALUE "InternalName", "cso-pak-gui"
            VALUE "LegalCopyright", "Y-Dr. Now"
            VALUE "OriginalFilename", "cso-pak-gui.exe"
            VALUE "ProductName", "CSO Pak Browser 1.2.1"
            VALUE "ProductVersion", "1.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
